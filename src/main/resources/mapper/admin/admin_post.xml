<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="adminPost">
	<resultMap type="QuestionPost" id="QnaResult" autoMapping="true">
		<id property="no" column="no" />
	
		<association property="answerPost" column="post_no" javaType="AnswerPost" autoMapping="true">
			<id property="postNo" column="post_no" />
		</association>
	</resultMap>
	
	<!-- 검색용 WHERE -->
	<sql id="search">
		<where>
			<!-- 답변이 없는 경우 -->
			<if test="answerState == 'waiting' and answerState != 'all'">
				q.is_answered = 0
			</if>
			
			<!-- 답변이 있는 경우 -->
			<if test="answerState == 'answered' and answerState != 'all'">
				q.is_answered = 1
			</if>
			
			<!-- 날짜 검색 -->
			<if test="startDate != null and startDate != ''">
				<![CDATA[
					q.created_at >= #{startDate}
				]]>
			</if>
			
			<if test="endDate != null and endDate != ''">
				<![CDATA[
					q.created_at <= #{endDate}
				]]>
			</if>
			
			<!-- 기본 검색 -->
			<if test="keyword != null and keyword != ''">
				<if test="search == 1">
					AND (
						q.title LIKE CONCAT('%', #{keyword}, '%')
						OR q.text LIKE CONCAT('%', #{keyword}, '%')
					)
				</if>
				
				<if test="search == 2">
					q.no = #{keyword}
				</if>
				
				<if test="search == 3">
					q.writerIp = #{keyword}
				</if>
			</if>
		</where>
	</sql>
	
	<select id="totalCountPost" resultType="Integer">
		SELECT count(*)
		FROM QUESTION_POST q
		
		<include refid="search"></include>
	</select>
	
	<select id="loadAllPosts" resultMap="QnaResult">
		SELECT *
		FROM QUESTION_POST q
		LEFT JOIN ANSWER_POST a ON a.post_no = q.no
		
		<include refid="search"></include>
		
		ORDER BY created_at DESC, no DESC
    	LIMIT #{offset}, #{perPage}
	</select>
	
	
	<!-- 답변글 등록 -->
	<insert id="registerAnswerPost">
		INSERT INTO ANSWER_POST
		(post_no, admin_id, answered_text, answered_at)
		VALUES
		(#{postNo}, #{adminId}, #{answeredText}, #{answeredAt})
	</insert>
</mapper>