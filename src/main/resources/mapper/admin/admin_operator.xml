<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="adminOperator">

    <!-- 전체 관리자 수 -->
    <select id="totalAdminCount" resultType="Integer">
        SELECT count(*)
        FROM ADMINS
    </select>

    <!-- 전체 관리자 목록 -->
    <select id="loadAdmins" resultType="Admin">
        SELECT *
        FROM ADMINS
        ORDER BY role, created_at DESC
        LIMIT #{offset}, #{perPage}
    </select>

    <!-- 관리자 상세 정보 조회 -->
    <select id="loadAdminDetailById" resultType="Admin">
        SELECT *
        FROM ADMINS
        WHERE id = #{id}
    </select>

    <!-- 관리자 권한 & 활성 상태 변경 -->
    <update id="modifyAdmin">
        UPDATE ADMINS
        <set>
            <if test="role != null">
                role = #{role},
            </if>
            <if test="isActive != null">
                is_active = #{isActive},
            </if>
            updated_at = #{updatedAt}
        </set>
        WHERE id = #{id}
    </update>

    <!-- 사용 가능한 아이디인지 검증 -->
    <select id="checkId" resultType="Integer">
        SELECT count(*)
        FROM ADMINS
        WHERE id = #{id}
    </select>

    <!-- 관리자 계정 등록 -->
    <insert id="registerAdminAccount">
        INSERT INTO ADMINS (id, pw, name, role, is_active, created_at)
        VALUES (#{id}, #{pw}, #{name}, #{role}, #{isActive}, now())
    </insert>

</mapper>
