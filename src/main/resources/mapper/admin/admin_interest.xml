<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="adminInterest">

    <select id="loadCategories" resultType="AdminInterestCategory">
        SELECT *
        FROM INTEREST_CATEGORY
    </select>

    <select id="loadKeywords" resultType="AdminInterestKeyword">
        SELECT IC.name AS category_name, IK.*
        FROM INTEREST_KEYWORD AS IK
        JOIN INTEREST_CATEGORY AS IC
        ON IK.CATE_NO = IC.NO
    </select>

</mapper>
